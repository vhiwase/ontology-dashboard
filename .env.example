# ============================================================================
#  TMS Ontology Platform - configuration
#  Copy to .env and adjust. `docker compose up` reads .env automatically.
# ============================================================================

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=ontology
POSTGRES_PASSWORD=ontology
POSTGRES_DB=tms_ontology
POSTGRES_PORT=55432
# Connection string used by every service inside the compose network.
DATABASE_URL=postgresql://ontology:ontology@postgres:5432/tms_ontology
# To run the pipeline from the host instead of the container, use 127.0.0.1 and
# NOT localhost:
#   DATABASE_URL=postgresql://ontology:ontology@127.0.0.1:55432/tms_ontology
# On Windows, localhost resolves to ::1 first, and Docker Desktop's IPv6 proxy
# accepts the TCP connection and then hangs, so libpq waits out a ~130 s timeout
# before falling back to IPv4. Measured: 130.6 s with localhost, 6.9 s with
# 127.0.0.1, for the identical run.

# ── Pipeline ────────────────────────────────────────────────────────────────
# Directory (inside the pipeline container) holding the captured TMS payloads.
# docker-compose mounts TMS_MCP/api_responses here read-only.
PIPELINE_SOURCE_DIR=/data/api_responses
# The captured snapshot has no execution actuals: no arrivals, no distances, no
# carrier assignment. With this true the pipeline generates them into the
# separate tms_sim schema so on-time, transit-time and cost-per-km KPIs are
# demonstrable. Every affected view reports data_origin = 'simulated'.
# Set false to run on measured data only; those KPIs then read as "no data".
PIPELINE_SIMULATE_EXECUTION=true
# Fixed seed keeps the simulated execution reproducible across rebuilds.
PIPELINE_SIM_SEED=20260919
# Re-run ingestion even when the tables already hold this snapshot.
PIPELINE_FORCE_REINGEST=false
# Minimum share of source values that must resolve to a target row before a
# discovered join is promoted to a link type. 0.05 keeps genuinely partial
# joins (origin ids split across Location and BillTo) while dropping noise.
PIPELINE_LINK_MIN_MATCH_RATIO=0.05

# ── Ontology service (Node + @ontograph/core) ───────────────────────────────
ONTOLOGY_SERVICE_PORT=4000
# Hard ceiling on rows returned by one object-set query.
ONTOLOGY_MAX_PAGE_SIZE=500

# ── AI-FDE assistant ────────────────────────────────────────────────────────
AI_FDE_PORT=4100
# Which LLM backend the assistant talks to:
#   auto          pick from the hardware (the default, and what bootstrap.sh sets)
#   ollama        the local open-source model
#   azure_openai  the Azure AI Foundry deployment used elsewhere in TMS_MCP
#
# `auto` resolves as: GPU present -> ollama primary; CPU only -> azure_openai
# primary. A 7B model with a fifteen-tool schema takes minutes per call on CPU and
# the agent makes several calls per question, so local-first is the wrong default
# on a machine without a GPU even though it is the nicer one.
LLM_PROVIDER=auto
# Used automatically when the primary errors or times out. Leave empty to disable
# failover and surface the primary's error instead.
LLM_FALLBACK_PROVIDER=
# After the primary fails it is skipped for this long rather than retried on every
# tool round - otherwise one turn pays the primary's timeout up to 8 times.
LLM_FALLBACK_COOLDOWN=300
# Set by scripts/bootstrap.sh from whether nvidia-smi works: true, false, or empty
# meaning "ask Ollama at startup whether it has GPU offload".
OLLAMA_GPU=
# Maximum tool-calling rounds per user turn before the agent must answer.
AI_FDE_MAX_TOOL_ROUNDS=8
AI_FDE_TEMPERATURE=0.1

# ── Ollama (open-source model, default backend) ─────────────────────────────
OLLAMA_BASE_URL=http://ollama:11434
# qwen2.5:7b-instruct is the default because it follows tool schemas reliably
# at ~4.7 GB. Alternatives, in order of hardware appetite:
#   qwen2.5:3b-instruct   ~2.0 GB  - for an 8 GB machine, weaker at multi-step
#   llama3.1:8b           ~4.9 GB  - comparable, slightly chattier
#   qwen2.5:14b-instruct  ~9.0 GB  - noticeably better at composing dashboards
OLLAMA_MODEL=qwen2.5:7b-instruct
# Pulled automatically on first `docker compose up` by the ollama-init service.
OLLAMA_AUTO_PULL=true
OLLAMA_KEEP_ALIVE=30m
# Host port for the containerised Ollama. Moved off 11434 because a native Ollama
# install on the host already listens there, and Docker cannot bind a port twice:
# the symptom is "ports are not available ... bind: Only one usage of each socket
# address". Services inside the compose network always reach it at ollama:11434,
# so this only affects access from the host.
# To use a native host Ollama instead of the container, set
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
# and stop the ollama/ollama-init services.
OLLAMA_PORT=11435
# Kept short on purpose: on CPU-only hardware failing over to the hosted model in
# 90 s beats waiting minutes for a local answer. The GPU overlay raises it to 180.
OLLAMA_TIMEOUT=90

# GPU: the official ollama image ships CUDA and ROCm backends only, so NVIDIA (or
# AMD ROCm) is required for offload. Apply the overlay to pass the device through:
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
# or let ./scripts/bootstrap.sh detect it. Intel Iris Xe / Arc and Apple Silicon
# are not covered by that image and will run on CPU.
OLLAMA_NUM_GPU=999

# ── Azure OpenAI ────────────────────────────────────────────────────────────
# The deployment already in use by TMS_MCP/ContractProcessing. Verified working
# with tool calling (gpt-4.1, ~2 s per call), which is what makes it a usable
# primary on CPU-only hardware and a usable fallback everywhere else.
#
# Leave AZURE_OPENAI_KEY blank and set LLM_PROVIDER=ollama to run fully offline.
AZURE_OPENAI_ENDPOINT=https://devtmsaifoundry.cognitiveservices.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TIMEOUT=120

# ── UI ──────────────────────────────────────────────────────────────────────
UI_PORT=3000
