# ============================================================================
#  TMS Ontology Platform - configuration
#  Copy to .env and adjust. `docker compose up` reads .env automatically.
# ============================================================================

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=ontology
# The password is NOT set here: ./scripts/init-secrets.sh generates a random
# one into ./secrets/postgres_password and builds the matching DSN in
# ./secrets/database_url. Both are mounted at /run/secrets.
POSTGRES_DB=tms_ontology
POSTGRES_PORT=55432
# Connection string used by every service inside the compose network.
# DATABASE_URL is likewise generated into ./secrets/database_url. Set it here
# only to point the stack at a database it did not create.
# To run the pipeline from the host instead of the container, use 127.0.0.1 and
# NOT localhost:
#   DATABASE_URL=postgresql://ontology:ontology@127.0.0.1:55432/tms_ontology
# On Windows, localhost resolves to ::1 first, and Docker Desktop's IPv6 proxy
# accepts the TCP connection and then hangs, so libpq waits out a ~130 s timeout
# before falling back to IPv4. Measured: 130.6 s with localhost, 6.9 s with
# 127.0.0.1, for the identical run.

# ── Pipeline ────────────────────────────────────────────────────────────────
# Directory (inside the pipeline container) holding the captured TMS payloads.
# docker-compose mounts TMS_MCP/api_responses here read-only.
PIPELINE_SOURCE_DIR=/data/api_responses
# The captured snapshot has no execution actuals: no arrivals, no distances, no
# carrier assignment. With this true the pipeline generates them into the
# separate tms_sim schema so on-time, transit-time and cost-per-km KPIs are
# demonstrable. Every affected view reports data_origin = 'simulated'.
# Set false to run on measured data only; those KPIs then read as "no data".
# Simulation is OFF.
#
# The captured snapshot is a PLANNING snapshot: it records what was intended,
# not what happened. It carries no carrier assignment, no execution actuals,
# no leg distance (every captured leg reports 0 m) and no arrivals.
#
# Generating those made 17 of 31 KPIs - every cost-per-km, transit-time and
# on-time figure - look authoritative while being invented. The platform now
# reports the gap instead of filling it.
#
# Turning this on is a deliberate act. What it writes goes to the separate
# tms_sim schema; the captured tms_raw data is never modified.
PIPELINE_SIMULATE_EXECUTION=false
# Fixed seed keeps the simulated execution reproducible across rebuilds.
PIPELINE_SIM_SEED=20260919
# Re-run ingestion even when the tables already hold this snapshot.
PIPELINE_FORCE_REINGEST=false
# Minimum share of source values that must resolve to a target row before a
# discovered join is promoted to a link type. 0.05 keeps genuinely partial
# joins (origin ids split across Location and BillTo) while dropping noise.
PIPELINE_LINK_MIN_MATCH_RATIO=0.05

# ── Ontology service (Node + @ontograph/core) ───────────────────────────────
ONTOLOGY_SERVICE_PORT=4000
# Hard ceiling on rows returned by one object-set query.
ONTOLOGY_MAX_PAGE_SIZE=500

# ── AI-FDE assistant ────────────────────────────────────────────────────────
AI_FDE_PORT=4100
# Which LLM backend the assistant talks to. azure_openai is the only provider;
# the variable exists so a typo'd value fails loudly at startup instead of
# being silently ignored.
LLM_PROVIDER=azure_openai
# Maximum tool-calling rounds per user turn before the agent must answer.
AI_FDE_MAX_TOOL_ROUNDS=8
AI_FDE_TEMPERATURE=0.1

# ── Scheduler ───────────────────────────────────────────────────────────────
# How often the ontology service checks platform.schedule for due work (syncs
# and pipelines that fire on an interval). 0 disables the loop entirely, which
# is what the tests want; production leaves it at the default 20 s. A tick that
# arrives while the previous one is still running is skipped, not queued.
SCHEDULE_TICK_SECONDS=20

# ── Azure OpenAI ────────────────────────────────────────────────────────────
# The deployment already in use by TMS_MCP/ContractProcessing. Verified working
# with tool calling (gpt-4.1, ~2 s per call), which is what makes it a usable
# primary on CPU-only hardware and a usable fallback everywhere else.
#
# The key is NOT set here any more: it lives in ./secrets/azure_openai_key,
# written by ./scripts/init-secrets.sh, because an environment value is visible
# to anyone who can run `docker inspect`.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TIMEOUT=120

# ── UI ──────────────────────────────────────────────────────────────────────
UI_PORT=3000

# ── Auth ────────────────────────────────────────────────────────────────────
# Creates the first admin on the next pipeline run, and only when no users
# exist. Leave the password unset and NO user is created: every API route then
# answers 401, which is a visible failure rather than a default credential.
# Add one later with:
#   docker compose run --rm pipeline python -m pipeline.users add <name> admin '<password>'
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

# Token lifetime in seconds (8 h), and the per-username login throttle.
AUTH_TOKEN_TTL=28800
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_WINDOW_MINUTES=15

# Comma-separated origins allowed to call the APIs cross-origin. Empty means
# same-origin only, which is what the nginx topology needs; it is here for a
# separately hosted front end.
CORS_ALLOWED_ORIGINS=

# ── Assistant cost controls ─────────────────────────────────────────────────
# /api/assistant/chat reaches a paid model for up to AI_FDE_MAX_TOOL_ROUNDS
# rounds, so both a rate and a spend ceiling apply, per user.
CHAT_RATE_PER_MINUTE=10
CHAT_RATE_BURST=5
# Rolling 24 h token budget per user. 0 disables it.
# Daily token budget per user. 0 = unlimited, which is the setting in use.
# The per-minute rate limit above still applies, and every turn's tokens and
# cost are still recorded on the Cost analysis page - removing the cap stops
# nothing from being measured, it only stops turns being refused.
CHAT_DAILY_TOKEN_BUDGET=0

# ── Retention ───────────────────────────────────────────────────────────────
# Days of chat history to keep; purged on each pipeline pass. 0 disables it.
# Set a real window if conversations can quote customer data.
CHAT_RETENTION_DAYS=0

# ── Serving ─────────────────────────────────────────────────────────────────
# The UI is served over HTTPS on UI_PORT. UI_HTTP_PORT only redirects to it and
# answers /health for the container healthcheck.
UI_HTTP_PORT=3080
# Names the self-signed certificate generated when none is mounted at
# /etc/nginx/certs. Mount a real certificate there for anything public.
TLS_COMMON_NAME=localhost

# ── Resource limits ─────────────────────────────────────────────────────────
# Every container is capped; these are the knobs.
POSTGRES_CPUS=2
POSTGRES_MEMORY=1g
PIPELINE_CPUS=2
PIPELINE_MEMORY=1g
ONTOLOGY_SERVICE_CPUS=2
ONTOLOGY_SERVICE_MEMORY=768m
AI_FDE_CPUS=2
AI_FDE_MEMORY=768m
UI_CPUS=1
UI_MEMORY=256m

# ── Simulated data ──────────────────────────────────────────────────────────
# The pipeline synthesises execution data into tms_sim when
# PIPELINE_SIMULATE_EXECUTION is on, which is what makes the service and cost
# KPIs answerable from a snapshot with no execution history.
#
# Set ALLOW_SIMULATED_DATA=false in production: the KPIs, dashboard widgets and
# actions that depend on tms_sim then return 409 instead of a number, so an
# invented figure cannot be quoted as a measured one.
ALLOW_SIMULATED_DATA=false
